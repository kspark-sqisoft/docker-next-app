# 아래 키는 서버 기동 시 `lib/env/server.ts`(Zod)로 한 번 검증됩니다.
# Edge·미들웨어에서는 이 모듈을 import 하지 않습니다.

# Prisma + PostgreSQL (로컬 또는 Compose 의 db 서비스 호스트명)
# 예: 로컬 호스트에서 컨테이너 DB 접속 시 포트는 compose 파일의 매핑에 맞춤
DATABASE_URL="postgresql://blog:blog@localhost:5433/blog"

# NextAuth (Auth.js) — 프로덕션 빌드 시 32자 미만이면 기동 실패
AUTH_SECRET="change_me_to_a_long_random_string_use_openssl_rand_base64_32"
# 앱의 공개 URL (OAuth·쿠키 등에 사용). Docker 프로덕션 예:
# AUTH_URL="http://localhost:3000"

# 업로드 파일 저장 루트 (게시글·프로필 이미지). 비우면 프로젝트 루트 ./uploads
# UPLOADS_DIR="/absolute/path/to/uploads"
